---
// Docs is the layout of the how-to pages: the shared page layout with a
// sidebar (the DocsSidebar, labelled "Docs") linking the docs index, then
// the docs pages (lib/docs-pages.ts), lowest order first; a breadcrumb
// above the article; and an "On this page" rail of the article's h2s
// (lib/headings.ts gives each h2 an id; scripts/toc.ts marks the section
// in view). The breadcrumb and the rail are their own landmarks, outside
// the sidebar and the article.
//
// Pages choose their shape, as the Studio design draws them:
// - width: the article's widest, 'prose' (720px, the default), 'wide'
//   (760px: What's new) or 'wider' (860px: Example game, to fit its
//   two panels);
// - toc: false leaves out the On this page rail (What's new, Limits and
//   Example game, whose wider articles take its place);
// - sidebar: false leaves out the sidebar and the rail, and the article
//   takes the full column (Coaching workflows).
import Base from './Base.astro';
import { docsPages } from '../lib/docs-pages';
import { withHeadingIds } from '../lib/headings';

interface Props {
  title: string;
  description?: string;
  width?: 'prose' | 'wide' | 'wider';
  toc?: boolean;
  sidebar?: boolean;
  // The page's name at the end of the breadcrumb, when shorter than its
  // title (Limits for "The hosted playmat's limits").
  crumb?: string;
}
const { title, description, width = 'prose', toc = true, sidebar = true, crumb } = Astro.props;

const items = await docsPages();
const here = Astro.url.pathname.replace(/\/$/, '');

// The trail to this page: the docs index, the workflows page above a
// workflow's own page, then this page (unlinked).
const trail: { href?: string; label: string }[] = [];
if (here === '/docs') {
  trail.push({ label: 'Docs' });
} else {
  trail.push({ href: '/docs', label: 'Docs' });
  if (here.startsWith('/docs/workflows/')) trail.push({ href: '/docs/workflows', label: 'Coaching workflows' });
  trail.push({ label: crumb ?? title });
}

const { html, headings } = withHeadingIds(await Astro.slots.render('default'));
const rail = sidebar && toc && headings.length >= 2;
---
<Base title={title} description={description}>
  <div class:list={['docs', `width-${width}`, { 'no-side': !sidebar, 'has-rail': rail }]}>
    {sidebar && (
      <nav class="docs-nav" aria-label="Docs">
        <span class="docs-nav-head">Docs</span>
        <ul>
          {items.map((i) => (
            <li><a href={i.href} aria-current={here === i.href ? 'page' : undefined}>{i.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        {trail.map((t) => (
          <li>{t.href ? <a href={t.href}>{t.label}</a> : <span aria-current="page">{t.label}</span>}</li>
        ))}
      </ol>
    </nav>
    {rail && (
      <nav class="on-this-page" aria-label="On this page" data-toc>
        <span class="docs-nav-head">On this page</span>
        <ul>
          {headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    )}
    <article class="prose">
      <Fragment set:html={html} />
    </article>
  </div>
</Base>

<style>
  /* Phone: the trail, the sidebar, the page's headings, then the article.
     From 52rem the sidebar (220px) stands beside them; from 76rem the
     headings move to their own 200px rail on the right, 40px apart. */
  .docs {
    --article: var(--prose-width);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'crumbs' 'side' 'toc' 'main';
    gap: var(--space-4) var(--space-10);
  }
  .docs.width-wide { --article: 760px; }
  .docs.width-wider { --article: 860px; }
  .docs-nav { grid-area: side; }
  .breadcrumb { grid-area: crumbs; }
  .on-this-page { grid-area: toc; }
  .prose { grid-area: main; min-width: 0; max-width: var(--article); }
  .docs.no-side { grid-template-areas: 'crumbs' 'main'; row-gap: 0; margin: var(--space-2) 0 calc(-1 * var(--space-2)); }
  .docs.no-side .prose { max-width: none; }
  @media (min-width: 52rem) {
    .docs:not(.no-side) {
      grid-template-columns: 220px minmax(0, var(--article));
      grid-template-rows: auto auto 1fr;
      grid-template-areas: 'side crumbs' 'side toc' 'side main';
      row-gap: 0;
    }
    .docs:not(.has-rail):not(.no-side) { grid-template-rows: auto 1fr; grid-template-areas: 'side crumbs' 'side main'; }
    .docs-nav { position: sticky; top: var(--space-4); align-self: start; }
    .on-this-page { margin: var(--space-2) 0 var(--space-2); }
  }
  @media (min-width: 76rem) {
    .docs.has-rail {
      grid-template-columns: 220px minmax(0, var(--article)) 200px;
      grid-template-rows: auto 1fr;
      grid-template-areas: 'side crumbs toc' 'side main toc';
    }
    .on-this-page { position: sticky; top: var(--space-4); align-self: start; margin: 0; }
  }

  .docs-nav-head {
    display: block;
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The sidebar: Studio rows, the current page filled. */
  .docs-nav { font-size: var(--fs-14); line-height: 1.4; }
  .docs-nav .docs-nav-head { padding: 0 10px 6px; }
  .docs-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px; }
  @media (min-width: 52rem) { .docs-nav ul { display: grid; } }
  .docs-nav a {
    display: block;
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .docs-nav a:hover { background: var(--hover); color: var(--ink); }
  .docs-nav a[aria-current='page'] { background: var(--selected); color: var(--primary); font-weight: 600; }

  .breadcrumb { font-size: var(--fs-13); color: var(--muted); }
  .breadcrumb ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .breadcrumb li + li::before { content: '/'; padding: 0 0.3em; }
  .breadcrumb a { color: var(--muted); }

  /* On this page: a rail with a line on its left, the section in view in
     primary. */
  .on-this-page { font-size: var(--fs-13); }
  .on-this-page ul { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: grid; gap: var(--space-2); }
  .on-this-page a { color: var(--ink-soft); text-decoration: none; }
  .on-this-page a:hover { color: var(--primary); text-decoration: underline; }
  .on-this-page a[aria-current='true'] { color: var(--primary); font-weight: 600; }
  @media (min-width: 76rem) {
    .on-this-page { padding-left: var(--space-4); box-shadow: inset 1px 0 0 var(--line); }
  }
  @media (max-width: 51.99rem) {
    /* Phone: the sidebar's rows line up with the trail, and the page's
       headings run on in a line rather than one per row. */
    .docs-nav { margin-left: -10px; }
    .on-this-page ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  }
  @media (max-width: 75.99rem) {
    .on-this-page {
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-l);
      background: var(--panel);
      box-shadow: 0 0 0 1px var(--line);
    }
  }
</style>
