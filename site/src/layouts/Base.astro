---
// Base is every page's layout, in the Studio style: the header (the mark
// and wordmark going home, the site navigation and Get started as a
// button), the page, and the dark footer with its link columns, the
// unofficial fan project notice and the card-data credit. The notice,
// credit and help address come from internal/notice/notice.json, the one
// wording meant to be shared with the board and the ChatGPT listing.
// Importing the facts and the notice here makes every page's build check
// them.
import '../../../internal/design/tokens.css';
import '../styles/site.css';
import { site } from '../lib/facts';
import { notice } from '../lib/notice';

interface Props {
  title?: string;
  description?: string;
  // A class for main, for a page that sets its own spacing (home, 404).
  mainClass?: string;
}
const fm = (Astro.props as { frontmatter?: Props }).frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description =
  Astro.props.description ??
  fm.description ??
  'tcgreplay rebuilds your Pokémon TCG Live games on a live board for your AI assistant to coach you through.';
const mainClass = Astro.props.mainClass;
const fullTitle = title ? `${title} · tcgreplay` : 'tcgreplay';

const nav = [
  { href: '/docs/workflows', label: 'Guides' },
  { href: '/docs/example', label: 'Example' },
  { href: '/docs/whats-new', label: "What's new" },
];
// The footer's Docs column (labelled "Docs links", so it stays apart from
// the docs sidebar's "Docs" landmark); its Project column holds the
// privacy page, the terms, help and the source.
const docsLinks = [
  { href: '/docs/connect', label: 'Get started' },
  { href: '/docs/workflows', label: 'Coaching workflows' },
  { href: '/docs/example', label: 'Example game' },
  { href: '/docs/whats-new', label: "What's new" },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
// A nav link is current on its page and on the pages under it (Guides on
// each workflow's page).
const current = (href: string) => (here === href || here.startsWith(`${href}/`) ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <!-- IBM Plex Sans and Mono from Google Fonts; system fonts stand in
         until they load, and if they cannot. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/"><img src="/logo.png" alt="" width="32" height="32" /><span class="wordmark">TCG Replay</span></a>
        <nav class="site-nav" aria-label="Site">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="button start" href="/docs/connect" aria-current={current('/docs/connect')}>Get started</a>
      </div>
    </header>
    <main class={mainClass}>
      <slot />
    </main>
    <footer class="site-footer" data-theme="dark">
      <div class="bar">
        <div class="footer-top">
          <div class="footer-about">
            <span class="footer-brand"><img src="/logo.png" alt="" width="28" height="28" />TCG Replay</span>
            <span class="footer-tagline">A live playmat for reviewing Pokémon TCG Live games with your AI assistant.</span>
          </div>
          <nav class="footer-col" aria-label="Docs links">
            <span class="footer-head">Docs</span>
            <ul>
              {docsLinks.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </nav>
          <nav class="footer-col footer-links" aria-label="Project">
            <span class="footer-head">Project</span>
            <ul>
              <li><a href="/privacy">Privacy</a></li>
              <li><a href="/terms">Terms</a></li>
              <li><a href={notice.help.url} aria-label={`Get help on ${notice.help.label}`}>Get help</a></li>
              <li><a href={site.repoURL}>Source on GitHub</a></li>
            </ul>
          </nav>
        </div>
        <div class="footer-small">
          <p class="fan-notice">{notice.notice}</p>
          <p class="credit">
            {notice.credit.lead}{' '}
            {notice.credit.sources.map((s, i) => (
              <Fragment>{i > 0 && (i === notice.credit.sources.length - 1 ? ' and ' : ', ')}<a href={s.url}>{s.name}</a></Fragment>
            ))}.
          </p>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/copy';
      import '../scripts/toc';
    </script>
  </body>
</html>
