---
// Base is every page's layout: the logo and navigation, the page, and the
// footer with the unofficial fan project notice, the card-data credit and
// links to the privacy page, the terms, help and the source. The notice, credit and
// help address come from internal/notice/notice.json, the one wording
// meant to be shared with the board and the ChatGPT listing. Importing the
// facts and the notice here makes every page's build check them.
import '../../../internal/design/tokens.css';
import '../styles/site.css';
import { site } from '../lib/facts';
import { notice } from '../lib/notice';

interface Props {
  title?: string;
  description?: string;
}
const fm = (Astro.props as { frontmatter?: Props }).frontmatter ?? {};
const title = Astro.props.title ?? fm.title;
const description =
  Astro.props.description ??
  fm.description ??
  'tcgreplay rebuilds your Pokémon TCG Live games on a live board for your AI assistant to coach you through.';
const fullTitle = title ? `${title} · tcgreplay` : 'tcgreplay';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/docs/connect', label: 'Get started' },
  { href: '/docs/workflows', label: 'Guides' },
  { href: '/docs/example', label: 'Example' },
  { href: '/docs/limits', label: 'Limits' },
  { href: '/privacy', label: 'Privacy' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/"><img src="/logo.png" alt="" width="36" height="36" />tcgreplay</a>
        <nav class="site-nav" aria-label="Site">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="bar">
        <p class="fan-notice">{notice.notice}</p>
        <p class="credit">
          {notice.credit.lead}{' '}
          {notice.credit.sources.map((s, i) => (
            <Fragment>{i > 0 && (i === notice.credit.sources.length - 1 ? ' and ' : ', ')}<a href={s.url}>{s.name}</a></Fragment>
          ))}.
        </p>
        <nav class="footer-links" aria-label="Footer">
          <ul>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href={notice.help.url} aria-label={`Get help on ${notice.help.label}`}>Get help</a></li>
            <li><a href={site.repoURL}>Source on GitHub</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import '../scripts/copy';
    </script>
  </body>
</html>
