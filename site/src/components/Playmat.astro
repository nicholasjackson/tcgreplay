---
// Playmat is the home page's scene of the playmat in action, drawn in the
// Studio board's colours: the slate mat with its zone panels, the turn
// strip with its navy turn tag, the timeline panel beside it, and the
// board's no-art cards (the text card, the Studio card back and the energy
// token, copied from web/src/components/Card.svelte). It never shows card
// artwork or Pokémon logos: the cards are plain stand-ins, and the card
// back's mark is drawn inline, never loaded as an image.
//
// Without script, and for visitors who ask for reduced motion, it is a still:
// the last moment of the story (a battle log imported, the board filled,
// the coach's suggestion, and the better line played). Otherwise a short
// script steps data-beat through log, board, coach, rewind and line, and
// starts again; CSS transitions on opacity and transform do the motion. It
// pauses while the tab is hidden or the scene is off screen, and loads
// nothing from the playmat or anywhere else.
type Side = 'p1' | 'p2';
type Card =
  | { kind: 'text'; name: string; hp?: number; stage: string; cat?: 'Pokemon' | 'Trainer' }
  | { kind: 'energy'; type: string }
  | { kind: 'back' };

const opponent: { active: Card; bench: Card[]; hand: number } = {
  active: { kind: 'text', name: 'Rival attacker', hp: 280, stage: 'Stage 2' },
  bench: [
    { kind: 'text', name: 'Rival support', hp: 70, stage: 'Basic' },
    { kind: 'text', name: 'Rival pivot', hp: 90, stage: 'Basic' },
  ],
  hand: 4,
};
const you: { active: Card; bench: Card[]; hand: Card[] } = {
  active: { kind: 'text', name: 'Your attacker', hp: 130, stage: 'Stage 1' },
  bench: [
    { kind: 'text', name: 'Second attacker', hp: 130, stage: 'Stage 1' },
    { kind: 'text', name: 'Support', hp: 70, stage: 'Basic' },
    { kind: 'energy', type: 'Fighting' },
  ],
  hand: [
    { kind: 'text', name: 'Draw card', stage: 'Supporter', cat: 'Trainer' },
    { kind: 'text', name: 'Search card', stage: 'Item', cat: 'Trainer' },
    { kind: 'energy', type: 'Fighting' },
  ],
};
// The log as imported; the line marked `line` belongs to the better line
// played after the rewind, and appears only then.
const log: { text: string; line?: boolean }[] = [
  { text: 'Turn 3 · Your turn' },
  { text: 'You drew a card.' },
  { text: 'You played Second attacker to your Bench.', line: true },
  { text: 'You attached Fighting Energy to Your attacker.' },
  { text: 'Your attacker used Strike on Rival attacker for 120 damage.' },
];
const coach = 'Turn 3: what if you bench a second attacker first?';
const label =
  'A playmat in the board’s colours with plain stand-in cards. A battle log sits beside the board, and the assistant suggests benching a second attacker on turn 3; the board shows that line played.';
const sides: Side[] = ['p2', 'p1'];

// The mark on the card back: the two cards and the replay arrow of
// internal/design/mark.svg, inline and coloured by the styles below (its
// navy square melts into the navy back, so it is left out).
const mark =
  '<svg class="mark" viewBox="0 0 30 30" aria-hidden="true" focusable="false">' +
  '<rect class="mark-back" x="7" y="8" width="10" height="14" rx="2" transform="rotate(-12 12 15)"/>' +
  '<rect class="mark-front" x="12" y="8" width="10" height="14" rx="2"/>' +
  '<path class="mark-arrow" d="M15.2 17.2a2.2 2.2 0 1 0 2.2-2.2h-1"/></svg>';

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// render draws one card the way the board draws a card without artwork.
function render(c: Card): string {
  switch (c.kind) {
    case 'back':
      return `<div class="back-art">${mark}</div>`;
    case 'energy':
      return `<div class="token" data-type="${esc(c.type)}" title="${esc(c.type)} Energy">${esc(c.type.slice(0, 1))}</div>`;
    case 'text':
      return `<div class="text-card" data-cat="${c.cat ?? 'Pokemon'}"><strong>${esc(c.name)}</strong>${
        c.hp ? `<span class="hp">HP ${c.hp}</span>` : ''
      }<small>${esc(c.stage)}</small></div>`;
  }
}
const back = render({ kind: 'back' });
---
<figure class="scene" data-playmat data-beat="line">
  <div class="stage" role="img" aria-label={label}>
    <div class="mat">
      <div class="sweep" aria-hidden="true"></div>
      {sides.map((side) => (
        <div class:list={['side', side]}>
          <span class="seat">{side === 'p1' ? 'You' : 'Rival'}</span>
          {side === 'p2' && (
            <>
              <div class="row hand">
                {Array.from({ length: opponent.hand }, (_, i) => <div class="card" style={`--i:${i}`} set:html={back} />)}
              </div>
              <div class="row bench zone">
                {opponent.bench.map((c, i) => <div class="card" style={`--i:${i + 4}`} set:html={render(c)} />)}
                <div class="slot" aria-hidden="true"></div>
              </div>
              <div class="row active zone"><div class="card" style="--i:6" set:html={render(opponent.active)} /></div>
            </>
          )}
          {side === 'p1' && (
            <>
              <div class="row active zone"><div class="card" style="--i:7" set:html={render(you.active)} /></div>
              <div class="row bench zone">
                {you.bench.map((c, i) =>
                  i === 0 ? (
                    <div class="card new" data-line style="--i:0" set:html={render(c)} />
                  ) : (
                    <div class="card" style={`--i:${i + 7}`} set:html={render(c)} />
                  ),
                )}
              </div>
              <div class="row hand">
                {you.hand.map((c, i) => <div class="card" style={`--i:${i + 10}`} set:html={render(c)} />)}
              </div>
            </>
          )}
          {side === 'p2' && (
            <div class="strip" aria-hidden="true">
              <span class="turn" data-turn>Turn 3</span>
              <span class="whose">Your turn</span>
              <span class="end-turn">End turn</span>
            </div>
          )}
        </div>
      ))}
    </div>
    <aside class="panel">
      <div class="log" aria-hidden="true">
        <span class="panel-title">Battle log</span>
        <ol>
          {log.map((l, i) => <li style={`--i:${i}`} data-log={l.line ? 'line' : undefined}>{l.text}</li>)}
        </ol>
      </div>
      <div class="coach" aria-hidden="true">
        <span class="panel-title">Coach</span>
        <p>{coach}</p>
      </div>
    </aside>
  </div>
  <figcaption aria-live="off">Paste a game and the assistant replays it, coaches you, and rewinds to try a better line.</figcaption>
</figure>

<script>
  // Steps the scene through its beats. With reduced motion asked for, it
  // never starts and the still (the last beat) stays.
  const beats: [string, number][] = [
    ['log', 2800],
    ['board', 2800],
    ['coach', 3000],
    ['rewind', 2200],
    ['line', 3600],
  ];
  const turnAt: Record<string, string> = { log: 'Turn 7', board: 'Turn 7', coach: 'Turn 7', rewind: 'Turn 3', line: 'Turn 3' };
  const scene = document.querySelector<HTMLElement>('[data-playmat]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  if (scene && !reduce.matches) {
    const turn = scene.querySelector<HTMLElement>('[data-turn]');
    const seen: string[] = [];
    let at = -1;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let onScreen = true;

    const show = (i: number) => {
      at = i;
      const [beat] = beats[i];
      if (beat === 'log') {
        // Start over from an empty board, without animating the reset.
        scene.classList.add('resetting');
        scene.dataset.beat = beat;
        void scene.offsetWidth;
        requestAnimationFrame(() => scene.classList.remove('resetting'));
      } else {
        scene.dataset.beat = beat;
      }
      if (turn) turn.textContent = turnAt[beat];
      seen.push(beat);
      scene.dataset.beatSeen = seen.slice(-20).join(' ');
    };
    const schedule = () => {
      clearTimeout(timer);
      if (document.hidden || !onScreen || reduce.matches) return;
      timer = setTimeout(() => {
        show((at + 1) % beats.length);
        schedule();
      }, beats[at][1]);
    };
    const stop = () => clearTimeout(timer);

    show(0);
    schedule();
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : schedule()));
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      onScreen ? schedule() : stop();
    }).observe(scene);
    reduce.addEventListener('change', () => {
      if (!reduce.matches) return schedule();
      stop();
      scene.dataset.beat = 'line';
      if (turn) turn.textContent = turnAt.line;
    });
  }
</script>

<style>
  .scene {
    margin: 0;
    width: 100%;
    max-width: 40rem;
    justify-self: center;
  }
  /* The frame: the slate mat (mat-* are the slate mat on the website, which
     has no data-mat), lit from the middle like the board's surface. */
  .stage {
    --w: clamp(30px, 6.4vw, 46px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(8.5rem, 0.62fr);
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background: radial-gradient(ellipse at 35% 50%, var(--mat-zone) 0%, var(--mat-surface) 70%);
    box-shadow: var(--shadow-hero), 0 0 0 1px var(--control-line);
    color: var(--mat-ink);
    font-family: var(--font-sans);
    font-size: var(--fs-12);
    line-height: 1.35;
    overflow: hidden;
  }
  .mat {
    position: relative;
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .side {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 2px 0;
  }
  .seat {
    position: absolute;
    left: 2px;
    top: 0;
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: var(--fw-ui-title);
  }
  .seat::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--seat-c);
  }
  .p1 { --seat-c: var(--seat-p1-mat); }
  .p2 { --seat-c: var(--seat-p2-mat); }
  .p1 .seat { top: auto; bottom: 0; }
  .row {
    display: flex;
    gap: calc(var(--w) * 0.14);
    justify-content: center;
    min-height: calc(var(--w) * 1.4);
  }
  .row.hand { --w: calc(clamp(30px, 6.4vw, 46px) * 0.72); min-height: calc(var(--w) * 1.4); }
  /* The board's zone panels: the Bench and the Active, the Active outlined
     in its player's colour. */
  .zone {
    padding: calc(var(--w) * 0.16);
    border-radius: 10px;
    background: var(--mat-zone);
  }
  .active.zone { box-shadow: inset 0 0 0 1.5px var(--seat-c); }
  .slot {
    width: var(--w);
    aspect-ratio: 63 / 88;
    border-radius: calc(var(--w) * 0.1);
    background: var(--mat-slot);
    box-shadow: inset 0 0 0 1px var(--mat-slot-line);
  }
  /* The turn strip between the halves: the navy turn tag, whose turn, and
     End turn in the accent the board keeps for it alone. */
  .strip {
    position: relative;
    z-index: 1;
    align-self: stretch;
    justify-self: stretch;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 5px 6px;
    border-radius: 10px;
    background: var(--mat-strip);
  }
  .turn {
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--brand-navy);
    color: var(--turn-tag-ink);
    font: var(--fw-num) var(--fs-11) / 1.3 var(--font-mono);
    white-space: nowrap;
  }
  .whose { flex: 1; font-weight: var(--fw-ui-title); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .end-turn {
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: var(--fs-10);
    white-space: nowrap;
  }
  .card {
    width: var(--w);
    aspect-ratio: 63 / 88;
    border-radius: calc(var(--w) * 0.1);
    flex: none;
    box-shadow: var(--shadow-card);
  }
  /* The card the better line brings in, lit as the board lights the cards
     an action touched. */
  .card.new { box-shadow: 0 0 0 2px var(--highlight-glow), var(--shadow-card); }

  /* The board's no-art cards (web/src/components/Card.svelte). The Studio
     back: navy, framed in cyan inside a navy edge, the mark in the middle. */
  .card :global(.back-art) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    display: grid;
    place-items: center;
    background: var(--brand-navy);
    border: calc(var(--w) * 0.05) solid var(--brand-navy);
    box-shadow: inset 0 0 0 max(1px, calc(var(--w) * 0.025)) var(--brand-cyan);
    box-sizing: border-box;
    overflow: hidden;
  }
  .card :global(.back-art .mark) { width: 78%; height: auto; aspect-ratio: 1; fill: none; pointer-events: none; }
  .card :global(.mark-back) { stroke: var(--brand-cyan); stroke-width: 1.8; }
  .card :global(.mark-front) { fill: var(--brand-navy); stroke: var(--glyph-ink); stroke-width: 1.8; }
  .card :global(.mark-arrow) { stroke: var(--brand-cyan); stroke-width: 1.6; stroke-linecap: round; }
  .card :global(.text-card) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    box-sizing: border-box;
    padding: 6%;
    display: flex;
    flex-direction: column;
    gap: 4%;
    background: var(--card-face);
    color: var(--card-face-ink);
    font-size: calc(var(--w) * 0.15);
    line-height: 1.15;
    overflow: hidden;
    border: calc(var(--w) * 0.04) solid var(--card-border-pokemon);
  }
  .card :global(.text-card[data-cat='Trainer']) { border-color: var(--card-border-trainer); background: var(--card-face-trainer); }
  .card :global(.text-card strong) { font-weight: var(--fw-ui-title); overflow-wrap: anywhere; }
  .card :global(.text-card .hp) { font-weight: 700; color: var(--card-hp); }
  .card :global(.text-card small) { opacity: 0.7; font-size: 0.9em; }
  .card :global(.token) {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    display: grid;
    place-items: center;
    font: 800 calc(var(--w) * 0.5) / 1 var(--font-sans);
    color: var(--glyph-ink);
    text-shadow: var(--shadow-text-energy);
    background: radial-gradient(circle at 50% 45%, var(--ec) 0 38%, var(--energy-ring) 39% 44%, var(--ec) 45%);
    --ec: var(--energy-colorless);
  }
  .card :global(.token[data-type='Fighting']) { --ec: var(--energy-fighting); }

  /* The timeline panel beside the mat: the battle log, then the coach's
     note, in the board's panel and note colours. */
  .panel {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 10px;
    min-width: 0;
    padding: 10px;
    border-radius: 12px;
    background: var(--panel);
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink);
  }
  .log, .coach { min-width: 0; }
  .log ol { position: relative; list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; }
  .log li { overflow-wrap: anywhere; padding: 2px 6px; border-radius: 4px; }
  /* The turn's heading, as the timeline heads a turn: its number and the
     player's dot. */
  .log li:first-child {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-inline: 0;
    font-family: var(--font-mono);
    font-weight: var(--fw-num);
  }
  .log li:first-child::after {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--seat-p1);
  }
  /* The better line's step, shown as the timeline shows the step the board
     is on. */
  .log li[data-log='line'] { background: var(--current); }
  .coach {
    padding: 8px 10px;
    border-radius: 6px;
    background: var(--note-bg);
    border: 1px solid var(--note-line);
    color: var(--note-ink);
  }
  .coach p { margin: 4px 0 0; }
  .panel-title {
    font: var(--fw-label) var(--fs-10) / var(--lh-label) var(--font-sans);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  figcaption { margin-top: 10px; color: var(--muted); font-size: var(--fs-13); }

  /* The beats. The default (no script, reduced motion) is the last beat,
     "line": everything shown. Earlier beats hide what hasn't happened yet.
     Motion is opacity and transform only. */
  .card,
  .coach,
  .log li,
  .turn {
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .card { transition-delay: calc(var(--i, 0) * 90ms); }
  .log li { transition-delay: calc(var(--i, 0) * 320ms); }
  .sweep {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background: linear-gradient(90deg, transparent, var(--scrim) 35%, var(--scrim) 65%, transparent);
    opacity: 0;
    transform: translateX(-100%);
    transition: opacity 0.5s ease, transform 0.9s ease;
    pointer-events: none;
    z-index: 2;
  }
  .scene.resetting *,
  .scene.resetting *::before {
    transition: none !important;
  }
  /* Before the board fills: nothing on it, the log arriving line by line. */
  .scene[data-beat='log'] .card,
  .scene.resetting .card {
    opacity: 0;
    transform: translateY(-12px) scale(0.9);
  }
  .scene.resetting .log li {
    opacity: 0;
    transform: translateX(-8px);
  }
  /* The coach speaks from the coach beat on. */
  .scene:is([data-beat='log'], [data-beat='board']) .coach,
  .scene.resetting .coach {
    opacity: 0;
    transform: translateY(8px);
  }
  /* The better line, and its log line, appear only after the rewind. */
  .scene:not([data-beat='line']) [data-line],
  .scene:not([data-beat='line']) .log li[data-log='line'] {
    opacity: 0;
    transform: translateY(-14px) scale(0.9);
  }
  /* Until then its log line takes no room, so the log reads as played. */
  .scene:not([data-beat='line']) .log li[data-log='line'] { position: absolute; visibility: hidden; transition-delay: 0s; }
  .scene[data-beat='line'] [data-line] { transition-delay: 0.3s; }
  /* The rewind: a sweep across the board and the turn tag ticking back. */
  .scene[data-beat='rewind'] .sweep {
    opacity: 1;
    transform: translateX(0);
  }
  .scene[data-beat='rewind'] .turn { transform: scale(1.25); }
  .scene[data-beat='rewind'] .coach { opacity: 0.6; }

  @media (prefers-reduced-motion: reduce) {
    .scene *,
    .scene *::before,
    .scene *::after {
      transition: none !important;
      animation: none !important;
    }
  }

  @media (max-width: 34rem) {
    .stage { grid-template-columns: minmax(0, 1fr); --w: clamp(30px, 10vw, 46px); }
    .row.hand { --w: calc(clamp(30px, 10vw, 46px) * 0.72); }
    .panel { grid-template-rows: auto auto; }
  }
</style>
