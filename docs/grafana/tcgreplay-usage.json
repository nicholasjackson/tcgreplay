      "id": 7,
      "type": "timeseries",
      "title": "Distinct players (player-days)",
      "description": "The last 14 days from the raw counters (Grafana Cloud Free keeps metrics for 14 days).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "interval": "1d",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(tcgreplay_player_days_total[1d]))",
          "legendFormat": "players",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
