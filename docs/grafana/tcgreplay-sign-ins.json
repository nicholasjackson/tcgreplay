          "expr": "sum(count_over_time({service_name=\"tcgreplay\"} | log_source=\"record\" | event=\"sign_in\" | provider=\"google\" [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
