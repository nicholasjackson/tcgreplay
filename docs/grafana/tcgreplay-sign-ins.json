    {
      "type": "timeseries",
      "title": "Sign-ins and refused attempts",
      "description": "Completed sign-ins by provider, and refused sign-ins by reason. Spikes of 'credentials' or any 'throttled' bars point at password guessing.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "A",
          "expr": "sum by (provider) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"record\" | event=\"sign_in\" [$__auto]))",
          "legendFormat": "signed in: {{provider}}"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "B",
          "expr": "sum by (reason) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"record\" | event=\"sign_in_refused\" | reason=~\"credentials|throttled\" [$__auto]))",
          "legendFormat": "refused: {{reason}}"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "C",
          "expr": "sum(count_over_time({service_name=\"tcgreplay\"} | log_source=\"record\" | event=\"sign_in_refused\" | reason!~\"credentials|throttled\" [$__auto]))",
          "legendFormat": "refused: player cap"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Google sign-in problems",
      "description": "Google sign-ins that failed after reaching TCG Replay. Occasional ones are stale links or a closed tab; a steady stream from the sign-in routes can mean forged or replayed sign-in links.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |~ \"hostauth: refused Google callback\" [$__auto]))",
          "legendFormat": "callback refused (state, cookie or used)"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "B",
          "expr": "sum(count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |~ \"hostauth: refused Google sign-in\" [$__auto]))",
          "legendFormat": "Google answer rejected"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "C",
          "expr": "sum(count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |~ \"Google sign-in not completed\" [$__auto]))",
          "legendFormat": "cancelled at Google"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "D",
          "expr": "sum(count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |~ \"hostauth: refused /auth/(signin|google|password): state does not match\" [$__auto]))",
          "legendFormat": "sign-in page: another browser's or no state"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Access refused, by reason",
      "description": "Every request the sign-in service turned away, by reason, plus requests stopped by the per-account request limit. 'no bearer token' is normal (an assistant's first connection); 'unknown or expired token' and 'not signed in' on odd paths are worth a look.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 11,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "A",
          "expr": "sum by (why) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |= \"hostauth: refused\" | regexp `hostauth: refused (?P<what>[^:]+)(: (?P<why>.*))?` [$__auto]))",
          "legendFormat": "{{why}}"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "refId": "B",
          "expr": "sum by (reason) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"record\" | event=\"limited\" [$__auto]))",
          "legendFormat": "limited: {{reason}}"
        }
      ]
    },
    {
      "type": "row",
