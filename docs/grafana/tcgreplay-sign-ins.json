    {
      "type": "table",
      "title": "Sign-ins by player",
      "description": "Sign-ins per pseudonymous player ID and provider. One player signing in far more than others may be a shared or abused account.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (player, provider) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"record\" | event=\"sign_in\" [$__range]))",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "count"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Paths probed while signed out",
      "description": "Requests refused because they were not signed in, by method and path. Paths like /.env, /wp-admin or /.git are scanners looking for leaked files.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 14,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "topk(20, sum by (what) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |= \"hostauth: refused\" | regexp `hostauth: refused (?P<what>[^:]+)(: (?P<why>.*))?` | why=\"not signed in\" [$__range])))",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "count"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Refused connector requests",
      "description": "Assistant-side refusals: missing or unknown tokens on /mcp, and authorization requests for unknown clients or unregistered redirects.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 15,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "topk(20, sum by (what, why) (count_over_time({service_name=\"tcgreplay\"} | log_source=\"log\" |= \"hostauth: refused\" | regexp `hostauth: refused (?P<what>[^:]+)(: (?P<why>.*))?` | what=~\".*(/mcp|authoriz|client|token).*\" [$__range])))",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "count"
            }
          }
        }
      ]
    },
