{
  "title": "tcgreplay sign-ins and misuse",
  "uid": "tcgreplay-sign-ins",
  "tags": [
    "tcgreplay"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Sign-ins, failed and throttled password attempts, Google sign-in problems, and requests the sign-in service refused. From the playmat's logs in Grafana Cloud (kept 14 days). Usernames, passwords and client addresses are never recorded.",
  "panels": [
    {
      "type": "row",
      "title": "At a glance (selected time range)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Google",
      "description": "Completed sign-ins with Google.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
